    <string name="cg_ingame_blocked_lead">Hideout games won’t show inside Deadlock.</string>
    <string name="cg_ingame_blocked_body">A mod in %1$s changes Deadlock’s HUD or Custom Match screen, and gameinfo.gi loads it ahead of Hideout. You can still host and join from here. Remove that mod, or load it after Hideout, then restart Deadlock.</string>
    <string name="cg_problem_menus_blocked_title">Another tool’s menus are in the way</string>
    <string name="cg_problem_menus_blocked_body">gameinfo.gi loads a folder with its own menus ahead of Hideout’s, so Deadlock can’t play a mode. Stop any Modlock dev session and close Deadlock, then try again.</string>
    <string name="cg_problem_slow_title">That took too long</string>
    <string name="cg_problem_slow_body">The game didn’t get ready in time. Try again.</string>
    <string name="cg_problem_reach_title">Couldn’t reach %1$s’s PC</string>
    <string name="cg_problem_reach_title_friend">Couldn’t reach your friend’s PC</string>
    <string name="cg_problem_reach_body">Hideout couldn’t connect, directly or by the backup route. Check you’re both online, then try again.</string>
    <string name="cg_problem_not_found_title">No game found</string>
    <string name="cg_problem_not_found_body">Check the code with your friend. Their game may have ended.</string>
    <string name="cg_problem_friend_ended_body">They ended it before you got in. Ask them for a new code if they host again.</string>
    <string name="cg_problem_listing_closed_title">That game has closed</string>
    <string name="cg_problem_listing_closed_body">Its host ended it before you got in. Pick another game in Servers.</string>
    <string name="cg_problem_listing_full_title">That game is full</string>
    <string name="cg_problem_listing_full_body">Try again when a player leaves, or pick another game in Servers.</string>
    <string name="cg_problem_listing_unreachable_title">Couldn’t look up that game</string>
    <string name="cg_problem_listing_unreachable_body">Hideout couldn’t reach hideouthq.gg. Check your connection, then try again.</string>
    <string name="cg_problem_invite_title">This code isn’t working</string>
    <string name="cg_problem_invite_body">Hideout couldn’t read your friend’s game. Make sure you both have the latest Hideout, then ask for a new code.</string>
    <string name="cg_problem_arena_title">%1$s couldn’t load its arena</string>
